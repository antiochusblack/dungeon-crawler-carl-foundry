<div class="carl-sheet-body">
<header class="hud"><small>WORLD DUNGEON // ITEM RECORD</small><input class="name" name="name" value="{{item.name}}"></header><div class="grid"><label>Rank<input name="system.rank" type="number" min="0" max="20" value="{{system.rank}}"></label><label>Stat<select name="system.stat">{{selectOptions stats selected=system.stat}}</select></label><label>Mana cost<input name="system.manaCost" min="0" type="number" value="{{system.manaCost}}"></label><label>Quantity<input name="system.quantity" min="0" type="number" value="{{system.quantity}}"></label><label>Damage formula<input name="system.damage" value="{{system.damage}}" placeholder="1d6"></label><label>Add Stat Mod<input name="system.damageMod" type="checkbox" {{checked system.damageMod}}></label><label>Passive<input name="system.passive" type="checkbox" {{checked system.passive}}></label><label>Hotlist<input name="system.hotlist" type="checkbox" {{checked system.hotlist}}></label></div><h2>DESCRIPTION / EFFECT</h2><textarea name="system.description">{{system.description}}</textarea><h2>REWARD</h2><textarea name="system.reward">{{system.reward}}</textarea>
</div>
