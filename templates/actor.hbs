<div class="carl-sheet-body">
<header class="hud"><small>WORLD DUNGEON // LIVE FEED</small><h1>DUNGEON CRAWLER CARL</h1><input class="name" name="name" value="{{actor.name}}"><div class="grid"><label>Level<input name="system.level" type="number" min="1" value="{{system.level}}"></label><label>Floor<input name="system.floor" type="number" min="1" value="{{system.floor}}"></label><label>Race<input name="system.race" value="{{system.race}}"></label><label>Class<input name="system.className" value="{{system.className}}"></label></div></header>
<nav class="tabs">{{#each tabs}}<a data-action="tab" data-group="primary" data-tab="{{id}}" class="{{cssClass}}">{{label}}</a>{{/each}}</nav><section class="tab {{tabs.overview.cssClass}}" data-group="primary" data-tab="overview"><h2>VITAL SIGNS</h2><div class="health">{{#each slots}}<span class="{{#if filled}}filled{{/if}}"></span>{{/each}}</div><div class="grid"><label>Health slots<input name="system.health.value" type="number" min="0" max="{{system.health.max}}" value="{{system.health.value}}"></label><label>Damage per slot<output>{{system.slot}}</output></label><label>Mana<input name="system.mana.value" type="number" min="0" max="{{system.mana.max}}" value="{{system.mana.value}}"> / {{system.mana.max}}</label><label>Damage Resistance<input name="system.dr" type="number" min="0" value="{{system.dr}}"></label></div><h2>CORE STATS</h2><div class="stats">{{#each stats}}<div><button type="button" data-action="stat" data-stat="{{key}}">{{label}} +{{mod}}</button><label>Unenhanced<input name="system.stats.{{key}}.base" type="number" min="1" value="{{base}}"></label><label>Enhancement<input name="system.stats.{{key}}.bonus" type="number" value="{{bonus}}"></label><output>{{total}}</output></div>{{/each}}</div>{{#if mob}}<h2>GM CONTROL PANEL</h2><p>Mobs use fixed difficulties. Roll damage from their ability entries.</p><div class="grid"><label>Action Difficulty<input name="system.mob.action" type="number" value="{{system.mob.action}}"></label><label>Evade Difficulty<input name="system.mob.evade" type="number" value="{{system.mob.evade}}"></label><label>Health slot count<input name="system.health.max" min="1" type="number" value="{{system.health.max}}"></label><label>Damage per slot<input name="system.mob.slot" min="1" type="number" value="{{system.mob.slot}}"></label><label>Tier<input name="system.mob.tier" value="{{system.mob.tier}}"></label></div>{{else}}<h2>CHECK CONTROLS</h2><div class="grid"><label>Difficulty<input name="system.roll.difficulty" type="number" value="{{system.roll.difficulty}}"></label><label>Situational bonus<input name="system.roll.bonus" type="number" value="{{system.roll.bonus}}"></label><label>Roll mode<select name="system.roll.mode">{{selectOptions modes selected=system.roll.mode}}</select></label><button type="button" data-action="evade">EVADE</button><label>AI Favor<input name="system.aiFavor" type="number" value="{{system.aiFavor}}"></label><label>Gold<input name="system.gold" type="number" value="{{system.gold}}"></label></div>{{/if}}</section><section class="tab {{tabs.abilities.cssClass}}" data-group="primary" data-tab="abilities"><h2>SKILL <button type="button" data-action="create" data-type="skill">+ ADD</button></h2>{{#each groups}}{{#if (eq type "skill")}}{{#each items}}<article class="item-row" data-item-id="{{id}}"><button type="button" data-action="use" data-id="{{id}}">{{name}}</button><span>Rank {{system.rank}}</span><button type="button" data-action="damage" data-id="{{id}}">Damage</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button></article>{{/each}}{{/if}}{{/each}}<h2>SPELL <button type="button" data-action="create" data-type="spell">+ ADD</button></h2>{{#each groups}}{{#if (eq type "spell")}}{{#each items}}<article class="item-row" data-item-id="{{id}}"><button type="button" data-action="use" data-id="{{id}}">{{name}}</button><span>Rank {{system.rank}}</span><button type="button" data-action="damage" data-id="{{id}}">Damage</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button></article>{{/each}}{{/if}}{{/each}}</section><section class="tab {{tabs.inventory.cssClass}}" data-group="primary" data-tab="inventory"><h2>WEAPON <button type="button" data-action="create" data-type="weapon">+ ADD</button></h2>{{#each groups}}{{#if (eq type "weapon")}}{{#each items}}<article class="item-row" data-item-id="{{id}}"><button type="button" data-action="use" data-id="{{id}}">{{name}}</button><span>Rank {{system.rank}}</span><button type="button" data-action="damage" data-id="{{id}}">Damage</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button></article>{{/each}}{{/if}}{{/each}}<h2>GEAR <button type="button" data-action="create" data-type="gear">+ ADD</button></h2>{{#each groups}}{{#if (eq type "gear")}}{{#each items}}<article class="item-row" data-item-id="{{id}}"><button type="button" data-action="use" data-id="{{id}}">{{name}}</button><span>Rank {{system.rank}}</span><button type="button" data-action="damage" data-id="{{id}}">Damage</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button></article>{{/each}}{{/if}}{{/each}}<h2>RACE <button type="button" data-action="create" data-type="race">+ ADD</button></h2>{{#each groups}}{{#if (eq type "race")}}{{#each items}}<article class="item-row" data-item-id="{{id}}"><button type="button" data-action="use" data-id="{{id}}">{{name}}</button><span>Rank {{system.rank}}</span><button type="button" data-action="damage" data-id="{{id}}">Damage</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button></article>{{/each}}{{/if}}{{/each}}<h2>CLASS <button type="button" data-action="create" data-type="class">+ ADD</button></h2>{{#each groups}}{{#if (eq type "class")}}{{#each items}}<article class="item-row" data-item-id="{{id}}"><button type="button" data-action="use" data-id="{{id}}">{{name}}</button><span>Rank {{system.rank}}</span><button type="button" data-action="damage" data-id="{{id}}">Damage</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button></article>{{/each}}{{/if}}{{/each}}</section><section class="tab {{tabs.achievements.cssClass}}" data-group="primary" data-tab="achievements"><h2>ACHIEVEMENT <button type="button" data-action="create" data-type="achievement">+ ADD</button></h2>{{#each groups}}{{#if (eq type "achievement")}}{{#each items}}<article class="item-row" data-item-id="{{id}}"><button type="button" data-action="use" data-id="{{id}}">{{name}}</button><span>Rank {{system.rank}}</span><button type="button" data-action="damage" data-id="{{id}}">Damage</button><button type="button" data-action="edit" data-id="{{id}}">Edit</button></article>{{/each}}{{/if}}{{/each}}</section><section class="tab {{tabs.notes.cssClass}}" data-group="primary" data-tab="notes"><h2>CRAWLER LOG</h2><textarea name="system.notes">{{system.notes}}</textarea></section>
</div>
